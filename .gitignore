# Publication allowlist: all unlisted files/directories are ignored by default.
/*
!/.gitignore
!/README.md
!/LICENSE
!/requirements.txt
!/__init__.py
!/datasets.py
!/engine.py
!/evaluate.py
!/losses.py
!/model.py
!/model_factory.py
!/modules.py
!/preprocess.py
!/presets.py
!/train.py
!/test.py
!/data/
/data/*
!/data/__init__.py
!/data/data_utils.py
!/data/transforms.py

# Explicitly exclude generated data, model artifacts and experiment outputs.
**/__pycache__/
*.py[cod]
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.npy
*.npz
*.nii
*.nii.gz
*.csv
*.log
*.tfevents*
*.h5
*.hdf5
*.pkl
*.pickle
.env*
